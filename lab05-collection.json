{
  "info": {
    "name": "Lab05 — Бүртгэлийн API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "S1: Идэвхтэй, CS201 үзсэн оюутан CS313-д бүртгүүлэхэд 201 OK",
      "item": [
        {
          "name": "Setup: PUT /students/B231234567",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/B231234567",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "B231234567"
              ]
            }
          }
        },
        {
          "name": "Setup: PUT /courses/CS313",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/CS313",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "CS313"
              ]
            }
          }
        },
        {
          "name": "POST /registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201', () => pm.response.to.have.status(201));",
                  "pm.test('result = OK', () => pm.expect(pm.response.json().result).to.eql('OK'));",
                  "pm.test('registrationID нь тоо (яг утгыг шалгахгүй)', () => pm.expect(pm.response.json().registrationID).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"B231234567\",\"courseID\":\"CS313\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
      ]
    },
